			<dc:format>application/pdf</dc:format>
			<dc:title>
				<rdf:Alt>
					<rdf:li xml:lang="x-default">e200z0 Power Architecture â„¢ Core - Reference Manual</rdf:li>
				</rdf:Alt>
			</dc:title>
			<dc:creator>
				<rdf:Seq>
					<rdf:li>Freescale Semiconductor</rdf:li>
					<rdf:li>Inc.</rdf:li>
				</rdf:Seq>
			</dc:creator>
			<dc:description>
				<rdf:Alt>
					<rdf:li xml:lang="x-default">The e200 processor family is a set of CPU cores that implement low-cost versions of the Power Architecture â„¢ Book E architecture. e200 processors are designed for deeply embedded control applications, which require low cost solutions rather than maximum performance. The e200z0 and e200z0h processors integrate an integer execution unit, branch control unit, instruction fetch and load/store units. Supports e200z0, e200z0h.</rdf:li>
				</rdf:Alt>
			</dc:description>
			<dc:subject>
				<rdf:Bag>
					<rdf:li>e200 processor family, e200z0, Power Architecture, Book E architecture, e200z0h, branch control unit</rdf:li>
				</rdf:Bag>
			</dc:subject>
		</rdf:Description>
